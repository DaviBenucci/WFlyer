{
  "name": "wflyer-site-institucional",
  "version": "0.1.0",
  "private": true,
  "description": "Site institucional público da W_Flyer.",
  "type": "module",
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.15.1 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "smoke:standalone": "node scripts/smoke-standalone.mjs",
    "smoke:indexing": "node scripts/smoke-indexing.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:dependencies": "node scripts/validate-locked-dependencies.mjs",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:storybook": "vitest run --project=storybook",
    "test:e2e": "playwright test tests/e2e --workers=1",
    "test:visual": "playwright test tests/visual --workers=1",
    "test:motion": "playwright test tests/motion --workers=1",
    "test:a11y": "playwright test tests/a11y --workers=1",
    "test:staging": "WFLYER_STAGING_GATE=1 playwright test tests/staging --workers=1",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "ai:route": "node scripts/ai-route-resolver.mjs",
    "validate:ai-routing": "node scripts/validate-ai-routing.mjs",
    "verify": "pnpm validate:dependencies && pnpm lint && pnpm typecheck && pnpm test && pnpm build:storybook && pnpm build"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "next": "16.4.0-canary.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
