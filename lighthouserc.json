{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/aplicacao-wflyer",
        "http://127.0.0.1:3000/servicos",
        "http://127.0.0.1:3000/contato",
        "http://127.0.0.1:3000/politica-de-privacidade"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "node scripts/start-lighthouse-server.mjs",
      "startServerReadyPattern": "LIGHTHOUSE_SERVER_READY",
      "startServerReadyTimeout": 60000,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
